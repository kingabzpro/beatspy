# BeatSPY environment variables (all optional).
# Export these in your shell, or store them with `beatspy setup`.
# The benchmark needs a key for whichever decision model you run; nothing else.

# --- Decision models (pick one per run) ---
# OpenAI Decisions API (public beta). Bills input tokens only, $0.10 per 1M.
OPENAI_API_KEY=
# TypeSafe Jev (System One). Bills input only, $0.042 per 1M; output is free.
TYPESAFE_API_KEY=
# Cloudflare Workers AI, for Clef ($0.24/1M input) and Clef-flash ($0.09/1M input).
# Both the account id and the token are required for the REST endpoint.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# --- Overrides (rarely needed; see ~/.beatspy/config.toml for the full set) ---
# BEATSPY_DECISION_MODEL=clef-flash
# BEATSPY_DECISION_BASE_URL=https://api.typesafe.ai/v1/systemone
# BEATSPY_DECISION_CONCURRENCY=6
# BEATSPY_DECISION_TIMEOUT_S=120

# Each variable also has a BEATSPY_-prefixed form (for example
# BEATSPY_TYPESAFE_API_KEY), which takes precedence over the plain name.