# BeatSPY environment variables (all optional).
# Export in your shell or store keys with beatspy setup. Values here are examples.

# Model endpoint: any OpenAI-compatible Chat Completions API.
# These three are all BeatSPY needs to run a benchmark.
BEATSPY_BASE_URL=http://localhost:11434/v1
BEATSPY_MODEL=llama3.1:8b
BEATSPY_API_KEY=

# Optional integrations
BEATSPY_OLOSTEP_API_KEY=
BEATSPY_FINNHUB_API_KEY=
BEATSPY_TIMEGPT_API_KEY=

# Overrides (rarely needed; see ~/.beatspy/config.toml for the full set)
# BEATSPY_TEMPERATURE=0.0
# BEATSPY_MAX_TURNS=8
# BEATSPY_FORECAST_PROVIDER=baseline
